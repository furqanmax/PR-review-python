# =====================================================================
#  .env.example  -  copy to .env and fill in:   cp .env.example .env && chmod 600 .env
#
#  Real environment variables override values in .env. Changes to .env apply without
#  restarting the portal (except PORTAL_URL / host / port).  Never commit .env.
# =====================================================================

# ---------------------------------------------------------------------
#  Keycloak login (REQUIRED - the portal does not start without it)
# ---------------------------------------------------------------------
# Quick start with a local Keycloak (Docker):
#   docker compose -f docker-compose.keycloak.yml up -d
#   python3 seed.py --keycloak --write-env        # creates realm/client/roles/admins, fills the 4 values below
#
# Server root (Keycloak 16 and older: add /auth). Local docker-compose: http://localhost:8180
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=pr-review
# Confidential OIDC client, standard flow. Redirect URI: <PORTAL_URL>/auth/callback,
# post-logout redirect URI: <PORTAL_URL>/logged-out
KEYCLOAK_CLIENT_ID=pr-review-portal
# Client > Credentials tab (seed.py --write-env fills it in)
KEYCLOAK_CLIENT_SECRET=
# Keycloak role names (client roles of KEYCLOAK_CLIENT_ID, or realm roles). Defaults shown.
# KEYCLOAK_ADMIN_ROLE=admin
# KEYCLOAK_REVIEWER_ROLE=reviewer
# KEYCLOAK_VIEWER_ROLE=viewer

# Keycloak admin account - only used by `seed.py --keycloak` (matches docker-compose.keycloak.yml)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# KEYCLOAK_ADMIN_REALM=master

# First portal admins (seed.py). Comma-separated emails or Keycloak usernames.
SEED_ADMINS=mohd@bizionictech.com,furqan@bizionictech.com
# Password seed.py gives the admin users it creates in Keycloak (empty = random, printed once)
SEED_ADMIN_PASSWORD=

# Login cookie: signing key (empty = random key saved in data/.secret_key) and lifetime in hours
# APP_SECRET_KEY=
# SESSION_HOURS=8

# Address people open the portal at (used for login redirects and report links).
# Must match the Keycloak client's redirect URIs.
PORTAL_URL=http://127.0.0.1:5000

# ---------------------------------------------------------------------
#  GitHub (required)
# ---------------------------------------------------------------------
# Personal access token. Classic: "repo" scope. Fine-grained: Contents + Pull requests read & write.
GITHUB_TOKEN=
# GITHUB_USERNAME=
# Default repository (owner/name) and owner whose repositories are listed
GITHUB_REPO=
GITHUB_OWNER=
# Email written on the rewritten commits (required)
NEW_EMAIL=
# Default base branch and prefilled branch name
DEV_BRANCH=dev
BRANCH_NAME=

# ---------------------------------------------------------------------
#  Review bot listening
# ---------------------------------------------------------------------
BOT_LOGIN=codeant
POLL_SECONDS=60
SETTLE_SECONDS=20
LISTEN_TIMEOUT_MINUTES=60
QUIET_MINUTES=5
STUCK_MINUTES=20
# STATUS_PATTERN=

# ---------------------------------------------------------------------
#  Slack
# ---------------------------------------------------------------------
# Bot token (scopes chat:write, files:write; canvases:write for canvases) + channel ID (starts with C)
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
# Or an incoming webhook (text only, no attachments)
SLACK_WEBHOOK_URL=
# html (one message with the report) or messages (one per comment). Settings > Slack sharing overrides it.
# SLACK_FORMAT=html
# canvas, pdf, html (comma-separated). Settings > Slack sharing overrides it.
SLACK_ATTACH=html
# SLACK_CANVAS_MODE=auto
# CHROME_PATH=

# Slack bot (slack_bot.py, Socket Mode)
SLACK_APP_TOKEN=
# SLACK_REQUEST_CHANNEL=pr-review
# ALLOWED_SLACK_USERS=
# BOT_MAX_JOBS=

# ---------------------------------------------------------------------
#  Jira Cloud
# ---------------------------------------------------------------------
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
JIRA_LABELS=codeant,pr-review
JIRA_SET_PRIORITY=1
# JIRA_TECH_DEBT_LABEL=technical-debt
# JIRA_TECH_DEBT_EPIC=

# ---------------------------------------------------------------------
#  Database (SQLite file, or Amazon RDS: PostgreSQL / MySQL)
# ---------------------------------------------------------------------
# Where reports, users and settings are stored:
#   sqlite    local file DB_PATH, created automatically, nothing to install (default)
#   postgres  Amazon RDS / Aurora PostgreSQL 12+          (pip install psycopg2-binary)
#   mysql     Amazon RDS / Aurora MySQL 5.7+/8, MariaDB   (pip install pymysql)
# Tables are created on first use. Test with:  python3 db.py --check
# Move existing data:  python3 db.py --copy-from data/reviews.db   (after switching DB_ENGINE; safe to re-run)
DB_ENGINE=sqlite
# SQLite only (old reports/*.json are imported once, automatically)
# DB_PATH=data/reviews.db

# RDS only. Endpoint: RDS console > Databases > <instance> > Connectivity & security > Endpoint.
# The database (DB_NAME) must already exist (RDS "Initial database name", or CREATE DATABASE pr_review).
DB_HOST=
# Default: 5432 for postgres, 3306 for mysql
# DB_PORT=
DB_NAME=pr_review
DB_USER=
DB_PASSWORD=
# Log in with an RDS IAM token instead of DB_PASSWORD (needs boto3, AWS credentials allowed rds-db:connect,
# and a user created for IAM: postgres "GRANT rds_iam TO <user>", mysql "IDENTIFIED WITH AWSAuthenticationPlugin AS 'RDS'")
# DB_IAM_AUTH=false
# Region for the IAM token (default: AWS_REGION / AWS_DEFAULT_REGION)
# DB_REGION=
# TLS: disable | require (default: encrypted, certificate not checked) | verify-ca | verify-full (recommended).
# verify-* needs the RDS CA bundle:  curl -o data/rds-global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DB_SSLMODE=require
# DB_SSL_CA=data/rds-global-bundle.pem
# DB_CONNECT_TIMEOUT=10
